<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700;900&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<link rel="icon" href="/images/ball.svg">
</head>
<body>
<header class="hd">
  <div class="wrap hd-in">
    <a class="logo" href="/">
      <img src="/images/ball.svg" alt="" width="34" height="34">
      <span><b>{{ site.shortTitle }}</b><small>リレーブログ</small></span>
    </a>
    <nav class="nav">
      <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>トップ</a>
      <a href="/gen/"{% if page.url.startsWith("/gen/") %} aria-current="page"{% endif %}>代別</a>
      <a href="/relay/"{% if page.url == "/relay/" %} aria-current="page"{% endif %}>リレー</a>
      <a href="/members/"{% if page.url.startsWith("/members/") %} aria-current="page"{% endif %}>メンバー</a>
    </nav>
  </div>
</header>
<main>
{{ content | safe }}
</main>
<footer class="ft">
  <div class="wrap ft-in">
    <p>© 慶應セパタクロークラブ</p>
    <a class="ft-admin" href="/admin/">メンバー用 編集ページ →</a>
  </div>
</footer>
</body>
</html>
