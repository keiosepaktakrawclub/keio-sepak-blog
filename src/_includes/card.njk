{% set au = members | member(post.data.author) %}
<a class="card" href="{{ post.url }}">
  {% if post.data.thumbnail %}<div class="card-img" style="background-image:url('{{ post.data.thumbnail | url }}')"></div>{% else %}<div class="card-img card-img--none"><img src="/images/ball.svg" alt=""></div>{% endif %}
  <div class="card-body">
    <div class="meta">
      {% if au %}<span class="chip">{{ au.gradYear | gen }}代目</span>{% endif %}
      <time datetime="{{ post.date | isoDate }}">{{ post.date | date }}</time>
    </div>
    <h3>{{ post.data.title }}</h3>
    <p>{{ post.content | excerpt(70) }}</p>
    <span class="by">{{ au.name if au else post.data.author }}</span>
  </div>
</a>
