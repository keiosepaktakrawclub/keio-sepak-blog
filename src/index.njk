---
layout: base.njk
---
{% set rs = relay.order | relayState(collections.posts) %}
{% set cur = members | member(rs.current) %}
{% set nxt = members | member(rs.next) %}
<section class="hero">
  <div class="hero-photo" role="img" aria-label="慶應セパタクロークラブの集合写真"></div>
  <div class="wrap hero-in">
    <p class="kicker">KEIO SEPAKTAKRAW CLUB</p>
    <h1>慶應セパの日常</h1>
    <p class="lead">慶應セパタクロークラブのメンバーが、練習や大会、日々のことを自由に綴るブログです。</p>
    <a class="ig-btn" href="https://www.instagram.com/keio.sepaktakraw2026/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg><span>Instagram</span><small>@keio.sepaktakraw2026</small></a>
  </div>
</section>

{% if cur %}
<section class="wrap baton">
  <div class="baton-now">
    <span class="kicker">NOW ON BATON</span>
    <p class="baton-name"><a href="/members/{{ cur.id }}/">{{ cur.name }}</a></p>
    <p class="baton-sub">{{ cur.gradYear | gen }}代目・{{ cur.gradYear | sotsu }}{% if cur.role %}・{{ cur.role }}{% endif %}</p>
  </div>
  <div class="baton-arrow" aria-hidden="true">→</div>
  <div class="baton-next">
    <span class="kicker">NEXT</span>
    <p>{{ nxt.name if nxt else "未定" }}</p>
  </div>
  <a class="baton-link" href="/relay/">リレー順を見る</a>
</section>
{% endif %}

<section class="wrap sec">
  <div class="sec-hd"><h2>最新の記事</h2></div>
  {% if collections.posts.length %}
  <div class="grid">
    {% for post in collections.posts | limit(6) %}{% include "card.njk" %}{% endfor %}
  </div>
  {% else %}<p class="empty">まだ記事がありません。最初の走者を待っています。</p>{% endif %}
</section>

<section class="wrap sec">
  <div class="sec-hd"><h2>代別ページ</h2></div>
  {% if generations.length %}
  <div class="gens">
    {% for g in generations %}
    <a class="gen" href="/gen/{{ g.gradYear }}/">
      <span class="gen-num">{{ g.gen }}<small>代目</small></span>
      <span class="gen-lb">{{ g.label }}</span>
      <span class="gen-ct">{{ (members | membersOf(g.gradYear)).length }}人 ・ {{ (collections.posts | byGen(g.gradYear, members)).length }}記事</span>
    </a>
    {% endfor %}
  </div>
  {% else %}<p class="empty">まだ代が登録されていません。編集ページの「メンバー」から登録してください。</p>{% endif %}
</section>
