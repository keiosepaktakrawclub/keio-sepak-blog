---
layout: base.njk
title: リレー順
permalink: /relay/
---
{% set rs = relay.order | relayState(collections.posts) %}
<section class="wrap sec page-hd">
  <p class="kicker">RELAY ORDER</p>
  <h1>リレー順</h1>
  <p class="lead">この順番でバトンが回ります。最後の人の次は先頭へ戻ります。</p>
</section>
<section class="wrap sec">
  <ol class="relay">
    {% for id in relay.order %}
    {% set m = members | member(id) %}
    {% set mp = collections.posts | byAuthor(id) %}
    <li class="{% if id == rs.current %}is-current{% endif %}">
      <span class="relay-no">{{ loop.index }}</span>
      <a class="relay-who" href="/members/{{ id }}/"><b>{{ m.name if m else id }}</b>{% if m %}<small>{{ m.gradYear | gen }}代目・{{ m.gradYear | sotsu }}</small>{% endif %}</a>
      <span class="relay-st">{% if id == rs.current %}<em>執筆中</em>{% elif mp.length %}最終 {{ mp[0].date | date }}{% else %}未執筆{% endif %}</span>
    </li>
    {% endfor %}
  </ol>
</section>
